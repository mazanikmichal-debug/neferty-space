type WithdrawResult = 
 variant {
   err: text;
   ok: nat64;
 };
type VisibilityResult = 
 variant {
   err: text;
   ok;
 };
type Value = 
 variant {
   Array: vec record {
                text;
                Value;
              };
   Blob: blob;
   Bool: bool;
   Int: int;
   Map: vec record {
              text;
              Value;
            };
   Nat: nat;
   Text: text;
 };
type TxStatus = 
 variant {
   completed;
   failed;
   pending;
 };
type TransferResult = 
 variant {
   err: text;
   ok;
 };
type TransactionEvent = 
 record {
   eventType: variant {
                Mint;
                Transfer;
              };
   from: opt principal;
   timestamp: int;
   to: principal;
 };
type TopUpResult = 
 variant {
   err: text;
   ok: record {
         cyclesMinted: nat;
         icpUsed: nat64;
         platformFee: nat64;
       };
 };
type TokenId = nat;
type Time = int;
type Standard = 
 record {
   name: text;
   url: text;
 };
type ProcessTopUpResult = 
 variant {
   err: text;
   ok: record {
         cyclesMinted: nat;
         icpUsed: nat64;
         platformFee: nat64;
       };
 };
type PendingTx = 
 record {
   amount: nat64;
   blockIndex: nat64;
   caller: principal;
   collectionId: principal;
   createdAt: int;
   lastAttemptAt: int;
   retryCount: nat;
   status: TxStatus;
 };
type NFTPageLite = 
 record {
   items: vec NFTMetadataLite;
   total: nat;
 };
type NFTMetadataLite = 
 record {
   collectionCanisterId: opt text;
   collectionName: opt text;
   createdAt: Time;
   description: text;
   history: vec TransactionEvent;
   isPublic: bool;
   name: text;
   owner: principal;
   tokenId: TokenId;
 };
type NFTMetadata = 
 record {
   collectionName: opt text;
   createdAt: Time;
   description: text;
   history: vec TransactionEvent;
   image: blob;
   isPublic: bool;
   name: text;
   owner: principal;
   tokenId: TokenId;
 };
type MintResult = 
 variant {
   err: text;
   ok: TokenId;
   paymentRequired;
 };
type HealthStatus = 
 record {
   daysPercentage: nat;
   daysRemaining: nat;
   estimatedStorageMB: nat;
   healthColor: CycleHealth;
   imagesRemaining: nat;
   rawCycles: nat;
   status: text;
 };
type CycleHealth = 
 variant {
   green;
   orange;
   red;
 };
type CollectionPhase = 
 variant {
   Bonus;
   Free;
   Premium;
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : {
  addAdmin: (newAdmin: principal) -> (variant {
                                        err: text;
                                        ok;
                                      });
  adminRetryTopUp: (blockIndex: nat64) -> (ProcessTopUpResult);
  cleanupCorruptedRegistry: () -> (nat);
  createMyCollection: () -> (variant {
                               err: text;
                               ok: principal;
                             });
  estimateCycles: (imageCount: nat) -> (nat) query;
  estimateICPForImages: (imageCount: nat, icpPriceUSD: float64) ->
   (float64) query;
  estimateImagesForICP: (icpAmount: float64, icpPriceUSD: float64) ->
   (nat) query;
  getAdminPrincipal: () -> (principal) query;
  getAllPublicNFTs: () -> (vec NFTMetadataLite) query;
  getAllPublicNFTsByOwner: (owner: principal) -> (vec NFTMetadataLite) query;
  getAllPublicNFTsPaginated: (offset: nat, limit: nat) -> (NFTPageLite) query;
  getCmcDepositAddress: () -> (text);
  getCollectionPhase: (user: principal) -> (CollectionPhase);
  getCollectionStatus: (collectionId: principal) ->
   (record {
      cycles: nat;
      imageCount: nat;
      ownerPrincipal: principal;
    });
  getFactoryAccountId: () -> (text) query;
  getICPPrice: () -> (float64);
  getMyCollection: (user: principal) -> (vec principal) query;
  getMyCollectionCycles: () -> (nat);
  getMyCollections: (user: principal) -> (vec principal) query;
  getMyHealthStatus: () -> (HealthStatus);
  getMyMintCount: (user: principal) -> (nat);
  getMyNFTs: () -> (vec NFTMetadataLite);
  getMyNFTsPaginated: (offset: nat, limit: nat) -> (NFTPageLite);
  getMyPendingTransactions: () -> (vec PendingTx) query;
  getNFT: (tokenId: TokenId) -> (opt NFTMetadata) query;
  getNFTHistory: (tokenId: TokenId) -> (opt vec TransactionEvent) query;
  getNFTImage: (tokenId: TokenId) -> (opt blob) query;
  getPendingTransactions: () -> (vec PendingTx) query;
  getPlatformFees: () -> (nat64);
  getStatus: () ->
   (record {
      cycles: nat;
      estimate_days: nat;
      heap_memory: nat;
      memory: nat;
    });
  getUserRegistryEntry: () -> (vec principal) query;
  icrc10_supported_standards: () -> (vec Standard) query;
  icrc7_description: () -> (opt text) query;
  icrc7_name: () -> (text) query;
  icrc7_owner_of: (tokenId: nat) -> (opt Account) query;
  icrc7_symbol: () -> (text) query;
  icrc7_token_metadata: (tokenIds: vec nat) ->
   (vec opt vec record {
                  text;
                  Value;
                }) query;
  icrc7_tokens: (prev: opt nat, take: opt nat) -> (vec nat) query;
  icrc7_tokens_of: (account: Account, prev: opt nat, take: opt nat) ->
   (vec nat) query;
  icrc7_total_supply: () -> (nat) query;
  /// Manual trigger — available for emergency use via Candid UI / frontend.
  /// Also purges any corrupted aaaaa-aa registry entries left from failed createMyCollection calls.
  initSelf: () -> ();
  isUsingDefaultCollection: (user: principal) -> (bool) query;
  listAdmins: () -> (vec principal) query;
  mintNFT: (name: text, description: text, image: blob, recipientOpt:
   opt principal, isPublic: bool, collectionName: opt text) -> (MintResult);
  processTopUp: (blockIndex: nat64, collectionId: principal) ->
   (ProcessTopUpResult);
  removeAdmin: (adminToRemove: principal) -> (variant {
                                                err: text;
                                                ok;
                                              });
  removeMyCollection: (collectionId: principal) ->
   (variant {
      err: text;
      ok: bool;
    });
  retryTopUp: (blockIndex: nat64) -> (ProcessTopUpResult);
  setNFTVisibility: (tokenId: TokenId, isPublic: bool) -> (VisibilityResult);
  topUpCollection: (blockIndex: nat64) -> (TopUpResult);
  transferNFT: (tokenId: TokenId, to: principal) -> (TransferResult);
  withdrawPlatformFees: (toPrincipal: principal) -> (WithdrawResult);
}
